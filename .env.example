# GitHub (optional - uses GITHUB_TOKEN from environment if not set)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# Spotify (required for music data)
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
# Get this by running: npm run spotify:auth
SPOTIFY_REFRESH_TOKEN=your_refresh_token

# Admin authentication (for editing main page content)
ADMIN_USER=your_admin_username
ADMIN_PASS=your_admin_password
# Session secret for secure cookie signing (generate a random string)
SESSION_SECRET=your_random_session_secret_here
