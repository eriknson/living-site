{
  "rewrites": [
    { "source": "/loading", "destination": "/loading/index.html" },
    { "source": "/loading/", "destination": "/loading/index.html" },
    { "source": "/", "destination": "/generated/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}

