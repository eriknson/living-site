{
  "routes": [
    { "src": "/loading/?", "dest": "/public/loading/index.html" },
    { "src": "/", "dest": "/generated/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
